{
  "expo": {
    "name": "EcoPick",
    "slug": "EcoPick",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./src/assets/logo.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./src/assets/logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#101713",
      "dark": {
        "image": "./src/assets/logo.png",
        "resizeMode": "contain",
        "backgroundColor": "#101713"
      }
    },
    "scheme": "ecopick",
    "ios": {
      "supportsTablet": true,
      "splash": {
        "image": "./src/assets/logo.png",
        "resizeMode": "contain",
        "backgroundColor": "#101713"
      }
    },
    "android": {
      "package": "com.luanthnh.EcoPick",
      "adaptiveIcon": {
        "foregroundImage": "./src/assets/logo.png",
        "backgroundColor": "#C3D9CA"
      },
      "splash": {
        "image": "./src/assets/logo.png",
        "resizeMode": "contain",
        "backgroundColor": "#101713"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./src/assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow EcoPick to use your location to find nearby cleanup spots."
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "Allow EcoPick to access your camera to take photos of waste.",
          "photosPermission": "Allow EcoPick to access your photos to attach waste images."
        }
      ],
      "expo-localization",
      "@react-native-community/datetimepicker"
    ],
    "extra": {
      "EXPO_PUBLIC_API_BASE_URL": "https://ecopick-api-iota.vercel.app",
      "EXPO_PUBLIC_DAKLAK_MAP_URL": "https://ecopick-api-iota.vercel.app",
      "EXPO_PUBLIC_DAKLAK_MAP_PAGE": "https://ecopick-api-iota.vercel.app/opendesign/mockups/daklak-map/",
      "EXPO_PUBLIC_OSRM_ROUTER_URL": "https://router.project-osrm.org",
      "router": {},
      "eas": {
        "projectId": "d04f2e6a-b4f5-4db9-ad5c-1366a421d0ee"
      }
    },
    "owner": "awsc"
  }
}
